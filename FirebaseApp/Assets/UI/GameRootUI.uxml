            <ui:VisualElement name="User5Name" class="RowCells" style="flex-grow: 1;">
                <ui:Label text="Label" name="User5NameText" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="ScoreRow" class="Rows">
            <ui:VisualElement name="ScoreHeader" class="RowCells RowHeader" style="flex-grow: 1;">
                <ui:Label text="Score" name="ScoreHeaderText" />
            </ui:VisualElement>
            <ui:VisualElement name="User1Score" class="RowCells" style="flex-grow: 1;">
