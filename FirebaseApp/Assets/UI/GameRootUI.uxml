            <ui:VisualElement name="User3Score" class="RowCells" style="flex-grow: 1;">
                <ui:Label text="Label" name="User3ScoreText" />
            </ui:VisualElement>
            <ui:VisualElement name="User4Score" class="RowCells" style="flex-grow: 1;">
                <ui:Label text="Label" name="User4ScoreText" />
            </ui:VisualElement>
            <ui:VisualElement name="User5Score" class="RowCells" style="flex-grow: 1;">
                <ui:Label text="Label" name="User5ScoreText" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
