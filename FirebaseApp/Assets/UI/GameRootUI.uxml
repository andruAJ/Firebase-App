<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Style.uss?fileID=7433441132597879392&amp;guid=5357c1ed64eb7314d9dfac315e5106ee&amp;type=3#Style" />
    <ui:VisualElement name="VisualContainer" style="flex-grow: 1; display: flex;">
        <ui:VisualElement name="UpperVisuals" style="flex-grow: 0; justify-content: center; align-self: center; align-content: center; flex-wrap: wrap; flex-direction: row; width: 100%; height: 6%; position: absolute;">
            <ui:Button text="LogOut" name="LogOut" class="UpperVisuals" style="width: auto; font-size: 30px; background-color: rgb(42, 115, 226); border-top-left-radius: 6px; border-top-right-radius: 6px; border-bottom-right-radius: 6px; border-bottom-left-radius: 6px; border-left-color: rgb(35, 87, 166); border-right-color: rgb(35, 87, 166); border-top-color: rgb(35, 87, 166); border-bottom-color: rgb(35, 87, 166); border-top-width: 0; border-right-width: 3px; border-bottom-width: 3px; border-left-width: 0; color: rgb(234, 233, 233); -unity-font-definition: url(&quot;project://database/Assets/TutorialInfo/Fonts/RobotoCondensed-Bold.ttf?fileID=12800000&amp;guid=b20f139c373fa4555a05cdd0036dfa44&amp;type=3#RobotoCondensed-Bold&quot;);" />
            <ui:Label text="0" name="CounterText" class="UpperVisuals" style="font-size: 46px;" />
            <ui:Label text="Usuario" name="Usuario" class="UpperVisuals" style="justify-content: center; align-self: center; align-content: center; font-size: 46px;" />
        </ui:VisualElement>
        <ui:VisualElement name="WinLabel" style="flex-grow: 1; visibility: visible; display: none; width: 50%; height: 17%; position: absolute; align-self: center; justify-content: center; align-items: center; align-content: center; top: 40%;">
            <ui:Label text="Label" name="WinText" style="font-size: 100px;" />
        </ui:VisualElement>
        <ui:VisualElement name="FriendsPanel" style="flex-grow: 0; visibility: visible; display: flex; width: 18%; height: 50%; position: absolute; align-self: center; justify-content: center; align-items: center; align-content: center; top: 25%; background-color: rgba(0, 54, 136, 0.82); left: 0%; border-top-left-radius: 0; border-top-right-radius: 14px; border-bottom-right-radius: 14px; border-bottom-left-radius: 0; border-top-width: 8px; border-right-width: 8px; border-bottom-width: 8px; border-left-width: 0; border-left-color: rgb(36, 98, 193); border-right-color: rgb(36, 98, 193); border-top-color: rgb(36, 98, 193); border-bottom-color: rgb(36, 98, 193);">
            <ui:VisualElement name="TitleTextBox" style="flex-grow: 0; -unity-text-align: upper-center; justify-content: center;">
                <ui:Label text="Currently online players" name="TitleText" style="font-size: 25%; top: auto; bottom: auto; color: rgb(234, 233, 233); -unity-font-definition: url(&quot;project://database/Assets/TutorialInfo/Fonts/RobotoCondensed-Bold.ttf?fileID=12800000&amp;guid=b20f139c373fa4555a05cdd0036dfa44&amp;type=3#RobotoCondensed-Bold&quot;);" />
            </ui:VisualElement>
            <ui:VisualElement name="Players" style="flex-grow: 1;">
                <ui:Label text="None" name="PlayerOnline1" style="font-size: 20%; top: auto; bottom: auto; color: rgb(234, 233, 233); -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=2230732570650464555&amp;guid=0f7e07c3904d2174f9e7593b9114441d&amp;type=3#NotInter-Regular&quot;);" />
                <ui:Label text="None" name="PlayerOnline2" style="font-size: 20%; top: auto; bottom: auto; color: rgb(234, 233, 233); -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=2230732570650464555&amp;guid=0f7e07c3904d2174f9e7593b9114441d&amp;type=3#NotInter-Regular&quot;);" />
                <ui:Label text="None" name="PlayerOnline3" style="font-size: 20%; top: auto; bottom: auto; color: rgb(234, 233, 233); -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=2230732570650464555&amp;guid=0f7e07c3904d2174f9e7593b9114441d&amp;type=3#NotInter-Regular&quot;);" />
                <ui:Label text="None" name="PlayerOnline4" style="font-size: 20%; top: auto; bottom: auto; color: rgb(234, 233, 233); -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=2230732570650464555&amp;guid=0f7e07c3904d2174f9e7593b9114441d&amp;type=3#NotInter-Regular&quot;);" />
                <ui:Label text="None" name="PlayerOnline5" style="font-size: 20%; top: auto; bottom: auto; color: rgb(234, 233, 233); -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=2230732570650464555&amp;guid=0f7e07c3904d2174f9e7593b9114441d&amp;type=3#NotInter-Regular&quot;);" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="MatchmakingPanel" style="flex-grow: 0; visibility: visible; display: flex; width: 18%; height: 50%; position: absolute; align-self: center; justify-content: flex-start; align-items: center; align-content: center; top: 25%; background-color: rgba(0, 54, 136, 0.82); left: auto; border-top-left-radius: 14px; border-top-right-radius: 0; border-bottom-right-radius: 0; border-bottom-left-radius: 14px; border-top-width: 8px; border-right-width: 0; border-bottom-width: 8px; border-left-width: 8px; border-left-color: rgb(36, 98, 193); border-right-color: rgb(36, 98, 193); border-top-color: rgb(36, 98, 193); border-bottom-color: rgb(36, 98, 193); right: 0%;">
            <ui:VisualElement name="TitleTextBox" style="flex-grow: 0; -unity-text-align: upper-center; justify-content: center; position: absolute; top: 0%; display: flex;">
                <ui:Label text="Players searching&#10; for a match" name="TitleText" style="font-size: 25%; top: auto; bottom: auto; color: rgb(234, 233, 233); -unity-font-definition: url(&quot;project://database/Assets/TutorialInfo/Fonts/RobotoCondensed-Bold.ttf?fileID=12800000&amp;guid=b20f139c373fa4555a05cdd0036dfa44&amp;type=3#RobotoCondensed-Bold&quot;);" />
            </ui:VisualElement>
            <ui:VisualElement name="Players" style="flex-grow: 0; top: 20%;">
                <ui:Label text="None" name="MatchPlayer1" style="font-size: 20%; top: auto; bottom: auto; color: rgb(234, 233, 233); -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=2230732570650464555&amp;guid=0f7e07c3904d2174f9e7593b9114441d&amp;type=3#NotInter-Regular&quot;);" />
                <ui:Label text="None" name="MatchPlayer2" style="font-size: 20%; top: auto; bottom: auto; color: rgb(234, 233, 233); -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=2230732570650464555&amp;guid=0f7e07c3904d2174f9e7593b9114441d&amp;type=3#NotInter-Regular&quot;);" />
                <ui:Label text="None" name="MatchPlayer3" style="font-size: 20%; top: auto; bottom: auto; color: rgb(234, 233, 233); -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=2230732570650464555&amp;guid=0f7e07c3904d2174f9e7593b9114441d&amp;type=3#NotInter-Regular&quot;);" />
                <ui:Label text="None" name="MatchPlayer4" style="font-size: 20%; top: auto; bottom: auto; color: rgb(234, 233, 233); -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=2230732570650464555&amp;guid=0f7e07c3904d2174f9e7593b9114441d&amp;type=3#NotInter-Regular&quot;);" />
                <ui:Label text="None" name="MatchPlayer5" style="font-size: 20%; top: auto; bottom: auto; color: rgb(234, 233, 233); -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=2230732570650464555&amp;guid=0f7e07c3904d2174f9e7593b9114441d&amp;type=3#NotInter-Regular&quot;);" />
            </ui:VisualElement>
            <ui:Button text="Search for a match" name="SearchMatchButton" style="position: absolute; bottom: 0%; border-top-left-radius: 6px; border-top-right-radius: 6px; border-bottom-right-radius: 6px; border-bottom-left-radius: 6px; border-left-width: 0; border-top-width: 0; border-bottom-width: 3px; border-right-width: 3px; border-left-color: rgb(35, 87, 166); border-right-color: rgb(35, 87, 166); border-top-color: rgb(35, 87, 166); border-bottom-color: rgb(35, 87, 166); color: rgb(234, 233, 233); background-color: rgb(42, 115, 226); -unity-font-definition: url(&quot;project://database/Assets/TutorialInfo/Fonts/RobotoCondensed-Bold.ttf?fileID=12800000&amp;guid=b20f139c373fa4555a05cdd0036dfa44&amp;type=3#RobotoCondensed-Bold&quot;);" />
        </ui:VisualElement>
        <ui:VisualElement name="LowerVisuals" style="flex-grow: 0; justify-content: center; align-self: center; align-content: center; flex-wrap: wrap; flex-direction: row; width: 100%; height: 6%; position: absolute; bottom: 0%;">
            <ui:Label text="Rival:" name="RivalPlaceholderText" class="UpperVisuals" style="font-size: 46px;" />
            <ui:Label text="Ninguno" name="NameRival" class="UpperVisuals" style="justify-content: center; align-self: center; align-content: center; font-size: 46px;" />
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="ScoreTable" style="flex-grow: 0; width: 70%; height: 70%; align-self: center; white-space: normal; flex-direction: row; display: none; border-top-width: 7px; border-right-width: 7px; border-bottom-width: 7px; border-left-width: 7px; border-left-color: rgba(32, 32, 32, 0.81); border-right-color: rgba(32, 32, 32, 0.81); border-top-color: rgba(32, 32, 32, 0.81); border-bottom-color: rgba(32, 32, 32, 0.81); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px;">
        <ui:VisualElement name="UserRow" class="Rows" style="display: flex;">
            <ui:VisualElement name="UserHeader" class="RowCells RowHeader" style="flex-grow: 1;">
                <ui:Label text="User" name="UserHeaderText" />
            </ui:VisualElement>
            <ui:VisualElement name="User1Name" class="RowCells" style="flex-grow: 1;">
                <ui:Label text="Label" name="User1NameText" />
